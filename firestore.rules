rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function activeAccount(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)/state/deleting);
    }
    match /users/{uid}/state/deleting {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['deleting'])
        && request.resource.data.deleting == true;
      allow list, delete: if false;
    }
    function validSchool() {
      let d = request.resource.data;
      return d.keys().hasAll(['schema', 'name', 'payload', 'revision', 'updatedAt'])
        && d.keys().hasOnly(['schema', 'name', 'payload', 'revision', 'updatedAt'])
        && d.schema == 1 && d.name is string && d.name.size() <= 70
        && d.payload is string && d.payload.size() <= 800000
        && d.revision is int && d.revision > 0 && d.updatedAt == request.time;
    }
    match /users/{uid}/schools/{schoolId} {
      allow get, list: if owner(uid);
      allow create: if owner(uid) && activeAccount(uid) && validSchool() && request.resource.data.revision == 1;
      allow update: if owner(uid) && activeAccount(uid) && validSchool()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
